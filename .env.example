# Celestial Reverie Mock 服务器配置模板 (.env.example)
PORT=7001
MOCK_MODE=true

# 默认主账号配置 (可选：留空则不设兜底账号，新用户在客户端直接注册新账号即可)
DEFAULT_USER_ID=
DEFAULT_USER_NAME=
DEFAULT_NICK_NAME=
DEFAULT_EMAIL=
DEFAULT_PASSWORD=
DEFAULT_CREDIT=10000

# 大模型接口配置 (兼容 OpenAI 格式接口)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Fish Audio 拟真语音合成接口
FISH_AUDIO_URL=https://api.fish.audio/v1/tts
FISH_AUDIO_KEY=your_fish_audio_key_here
FISH_AUDIO_VOICE_ID=889e931050c04afebb9866644ae8e5a1
FISH_AUDIO_MODEL=s2.1-pro

# 本地代理配置 (如果需要通过本地代理访问海外接口)
# PROXY_URL=http://127.0.0.1:10808
NO_PROXY=localhost,127.0.0.1

# 客户端本地音频缓存目录（可选：默认自动探测用户目录，亦可在此显式指定）
# CLIENT_AUDIO_DIR=C:\Users\<你的Windows用户名>\AppData\LocalLow\SingularDance\CelestialReverie\MP3Audios
